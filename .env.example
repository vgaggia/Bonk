# Discord Bot token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1

# Stability AI API Key
STABILITY_API_KEY=your_stability_api_key_here

# Replicate API Token
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Luma Labs API Key
LUMALABS_API_KEY=your_lumalabs_api_key_here

# Optional settings
CHAT_MODEL="ANTHROPIC"                 # Default chat backend: ANTHROPIC | GPT-4O | LOCAL
GPT_ENGINE="claude-sonnet-4-20250514"  # Anthropic model to use when CHAT_MODEL=ANTHROPIC
LISTEN_STT_BACKEND="whisperx_http"     # STT backend for /listen: openai | whisperx_http
WHISPERX_HTTP_URL="http://127.0.0.1:5001/transcribe"  # whisperx sidecar HTTP endpoint
WHISPERX_MODEL="large-v3"              # WhisperX model: tiny, base, small, medium, large-v2, large-v3 (most accurate)
WHISPERX_MIN_CONFIDENCE="0.5"          # Minimum confidence for transcriptions (0.0-1.0, default 0.5)
LOGGING="True"
REPLYING_ALL="False"
DISCORD_CHANNEL_ID="your_channel_id_here"
DISCORD_CHANNEL_ID2="your_channel_id_here"
REPLYING_ALL_DISCORD_CHANNEL_ID=""

# Local Model Settings (optional)
LOCAL_API_BASE="http://127.0.0.1:5000/v1"
LOCAL_MODEL_API_KEY=your_local_model_key_here
LOCAL_SYSTEM_PROMPT="Act lively, and do your best to emulate being vgaggia, don't say sentences too short. And also your in a playful mood. The following is an emulated conversation with vgaggia:"
